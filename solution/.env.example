# Copy this file to .env (same folder) and fill in YOUR key. Never paste a key into your coding agent's chat.
# .env is ignored by git. Everything works WITHOUT a key (offline stand-in); a key is only for --live runs.
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: the default live model (each model has its own free quota). Default: gemini-3.5-flash-lite
GEMINI_MODEL=
# Optional: the longest total wait on 429/503 before a live call gives up, in seconds (default 70)
LLM_MAX_WAIT_SECONDS=

# Optional trace viewer (--export langfuse). Needs: pip install "langfuse==5.2.0"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
