# Copy this file to .env (Mac: cp .env.example .env   Windows cmd: copy .env.example .env).
# Everything works offline with the built-in stand-in model and NO keys. Fill in a line only for the optional extras.
# Paste keys into .env only. Never paste a key into a coding agent chat, a slide, or a screenshot.

# Optional: --live runs. Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional: --export langfuse (your own free account at https://cloud.langfuse.com, toy data only).
# Needs: pip install langfuse==5.2.0. Without these keys the export prints a trace tree in the terminal instead.
# US-region projects use LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
